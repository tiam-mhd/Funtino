{
  "schemaVersion": 1,
  "bundle": "backend",
  "shutdownTimeoutMs": 15000,
  "health": {
    "host": "127.0.0.1",
    "connectionTimeoutMs": 5000,
    "startupTimeoutMs": 180000,
    "retryIntervalMs": 1000
  },
  "commonEnv": ["NODE_ENV", "APP_VERSION"],
  "processes": [
    {
      "name": "organization-branch",
      "cwd": ".",
      "args": ["scripts/worker-startup.mjs", "organization-branch"],
      "port": 4050,
      "portEnv": "ORGANIZATION_BRANCH_PORT",
      "readinessPath": "/health/ready",
      "env": [
        "ORGANIZATION_BRANCH_DATABASE_URL",
        "ORGANIZATION_BRANCH_MIGRATION_DATABASE_URL",
        "RABBITMQ_URL",
        "ORGANIZATION_BRANCH_METRICS_TOKEN",
        "ORGANIZATION_BRANCH_GATEWAY_TOKEN",
        "ORGANIZATION_BRANCH_IDENTITY_ACCESS_TOKEN",
        "ORGANIZATION_BRANCH_DEVICE_INTEGRATION_TOKEN",
        "ORGANIZATION_BRANCH_WALLET_TOKEN"
      ]
    },
    {
      "name": "identity-access",
      "cwd": ".",
      "args": ["scripts/worker-startup.mjs", "identity-access"],
      "port": 4040,
      "portEnv": "IDENTITY_ACCESS_PORT",
      "readinessPath": "/health/ready",
      "env": [
        "IDENTITY_ACCESS_DATABASE_URL",
        "IDENTITY_ACCESS_MIGRATION_DATABASE_URL",
        "RABBITMQ_URL",
        "ORGANIZATION_BRANCH_URL",
        "API_PORT",
        "IDENTITY_ACCESS_MANAGEMENT_WRITES_ENABLED",
        "SYSTEM_ADMIN_BOOTSTRAP_LOOKUP_TOKEN",
        "IDENTITY_ACCESS_SERVICE_TOKEN",
        "IDENTITY_ACCESS_METRICS_TOKEN",
        "ORGANIZATION_BRANCH_IDENTITY_ACCESS_TOKEN",
        "IDENTITY_ACCESS_MFA_ACTIVE_KEY_VERSION",
        "IDENTITY_ACCESS_MFA_ENCRYPTION_KEYS",
        "IDENTITY_ACCESS_LOOKUP_ACTIVE_KEY_VERSION",
        "IDENTITY_ACCESS_LOOKUP_HMAC_KEYS"
      ]
    },
    {
      "name": "customer-household",
      "cwd": ".",
      "args": ["scripts/worker-startup.mjs", "customer-household"],
      "port": 4080,
      "portEnv": "CUSTOMER_HOUSEHOLD_PORT",
      "readinessPath": "/health/ready",
      "env": [
        "CUSTOMER_HOUSEHOLD_DATABASE_URL",
        "CUSTOMER_HOUSEHOLD_MIGRATION_DATABASE_URL",
        "RABBITMQ_URL",
        "CUSTOMER_HOUSEHOLD_METRICS_TOKEN",
        "CUSTOMER_HOUSEHOLD_GATEWAY_TOKEN",
        "CUSTOMER_HOUSEHOLD_WALLET_TOKEN"
      ]
    },
    {
      "name": "wallet",
      "cwd": ".",
      "args": ["scripts/worker-startup.mjs", "wallet"],
      "port": 4070,
      "portEnv": "WALLET_PORT",
      "readinessPath": "/health/ready",
      "env": [
        "WALLET_DATABASE_URL",
        "WALLET_MIGRATION_DATABASE_URL",
        "RABBITMQ_URL",
        "WALLET_ORGANIZATION_BRANCH_INTERNAL_URL",
        "WALLET_CUSTOMER_HOUSEHOLD_INTERNAL_URL",
        "WALLET_METRICS_TOKEN",
        "WALLET_GATEWAY_TOKEN",
        "WALLET_ORGANIZATION_BRANCH_TOKEN",
        "WALLET_CUSTOMER_HOUSEHOLD_TOKEN"
      ]
    },
    {
      "name": "analytics-read-model",
      "cwd": ".",
      "args": ["scripts/worker-startup.mjs", "analytics-read-model"],
      "port": 4060,
      "portEnv": "ANALYTICS_PORT",
      "readinessPath": "/health/ready",
      "env": [
        "ANALYTICS_DATABASE_URL",
        "ANALYTICS_MIGRATION_DATABASE_URL",
        "RABBITMQ_URL",
        "DEVICE_HEALTH_STALE_AFTER_SECONDS",
        "DEVICE_HEALTH_OFFLINE_AFTER_SECONDS",
        "ANALYTICS_METRICS_TOKEN",
        "ANALYTICS_API_GATEWAY_TOKEN"
      ]
    },
    {
      "name": "device-integration",
      "cwd": "services/device-integration",
      "args": ["dist/main.js"],
      "port": 4020,
      "portEnv": "DEVICE_PORT",
      "readinessPath": "/health/ready",
      "startupTimeoutMs": 60000,
      "env": [
        "DEVICE_INTEGRATION_METRICS_TOKEN",
        "DEVICE_INTEGRATION_DATABASE_URL",
        "DEVICE_INTEGRATION_GATEWAY_TOKEN",
        "DEVICE_WEBHOOK_SECRET",
        "ORGANIZATION_BRANCH_INTERNAL_URL",
        "DEVICE_INTEGRATION_ORGANIZATION_BRANCH_TOKEN",
        "RABBITMQ_URL",
        "DEVICE_HEALTH_STALE_AFTER_SECONDS",
        "DEVICE_HEALTH_OFFLINE_AFTER_SECONDS"
      ]
    },
    {
      "name": "notifications",
      "cwd": "services/notifications",
      "args": ["dist/main.js"],
      "port": 4030,
      "portEnv": "NOTIFICATIONS_PORT",
      "readinessPath": "/health/ready",
      "startupTimeoutMs": 60000,
      "env": ["NOTIFICATIONS_METRICS_TOKEN", "RABBITMQ_URL"]
    },
    {
      "name": "realtime-gateway",
      "cwd": "apps/realtime-gateway",
      "args": ["dist/main.js"],
      "port": 4010,
      "portEnv": "REALTIME_PORT",
      "readinessPath": "/health/ready",
      "startupTimeoutMs": 60000,
      "env": ["REALTIME_METRICS_TOKEN", "CORS_ORIGINS", "API_BASE_URL", "RABBITMQ_URL"]
    },
    {
      "name": "api-gateway",
      "cwd": "apps/api-gateway",
      "args": ["dist/main.js"],
      "port": 4000,
      "portEnv": "API_PORT",
      "readinessPath": "/health/ready",
      "startupTimeoutMs": 60000,
      "env": [
        "API_METRICS_TOKEN",
        "CORS_ORIGINS",
        "API_BASE_URL",
        "STORAGE_MODE",
        "DATABASE_URL",
        "RABBITMQ_URL",
        "REDIS_URL",
        "PROMETHEUS_INTERNAL_URL",
        "SESSION_COOKIE_DOMAIN",
        "SYSTEM_ADMIN_OWNER_PHONE_E164",
        "SYSTEM_ADMIN_BOOTSTRAP_LOOKUP_TOKEN",
        "EXPOSE_DEV_OTP",
        "PARSGREEN_API_TOKEN",
        "PARSGREEN_AUTH_HEADER",
        "PARSGREEN_OTP_URL",
        "PARSGREEN_OTP_TEMPLATE_ID",
        "PARSGREEN_ADD_NAME",
        "PARSGREEN_REQUEST_TIMEOUT_MS",
        "IDENTITY_ACCESS_URL",
        "IDENTITY_ACCESS_SERVICE_TOKEN",
        "ORGANIZATION_BRANCH_URL",
        "ORGANIZATION_BRANCH_INTERNAL_URL",
        "ORGANIZATION_BRANCH_GATEWAY_TOKEN",
        "DEVICE_INTEGRATION_URL",
        "DEVICE_INTEGRATION_GATEWAY_TOKEN",
        "DEVICE_INTEGRATION_ORGANIZATION_BRANCH_TOKEN",
        "WALLET_URL",
        "WALLET_GATEWAY_TOKEN",
        "CUSTOMER_HOUSEHOLD_URL",
        "CUSTOMER_HOUSEHOLD_GATEWAY_TOKEN",
        "ANALYTICS_READ_MODEL_URL",
        "ANALYTICS_API_GATEWAY_TOKEN"
      ]
    }
  ]
}
