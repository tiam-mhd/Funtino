{
  "schemaVersion": 1,
  "bundle": "frontend",
  "shutdownTimeoutMs": 10000,
  "health": {
    "host": "127.0.0.1",
    "connectionTimeoutMs": 5000,
    "startupTimeoutMs": 60000,
    "retryIntervalMs": 1000
  },
  "commonEnv": ["NODE_ENV", "APP_VERSION"],
  "processes": [
    {
      "name": "customer-web",
      "cwd": "apps/customer-web",
      "args": [
        "node_modules/next/dist/bin/next",
        "start",
        "--hostname",
        "0.0.0.0",
        "--port",
        "3000"
      ],
      "port": 3000,
      "readinessPath": "/",
      "env": []
    },
    {
      "name": "operations-web",
      "cwd": "apps/operations-web",
      "args": [
        "node_modules/next/dist/bin/next",
        "start",
        "--hostname",
        "0.0.0.0",
        "--port",
        "3001"
      ],
      "port": 3001,
      "readinessPath": "/",
      "env": []
    },
    {
      "name": "system-web",
      "cwd": "apps/system-web",
      "args": [
        "node_modules/next/dist/bin/next",
        "start",
        "--hostname",
        "0.0.0.0",
        "--port",
        "3002"
      ],
      "port": 3002,
      "readinessPath": "/",
      "env": []
    }
  ]
}
