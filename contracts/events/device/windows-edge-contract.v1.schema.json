{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.funtino.ir/events/device/windows-edge-contract.v1.schema.json",
  "title": "Funtino Windows Edge contract 1.0.0",
  "$defs": {
    "EdgeTransactionPayload": {
      "type": "object",
      "required": [
        "eventId",
        "sourceInstanceId",
        "localTransactionId",
        "sourceDatabase",
        "organizationId",
        "branchId",
        "cardId",
        "householdId",
        "memberId",
        "deviceId",
        "sourceDeviceId",
        "attractionId",
        "transactionKind",
        "amountRial",
        "currencyCode",
        "grossAmountRial",
        "discountAmountRial",
        "netAmountRial",
        "promotionId",
        "ruleId",
        "pricingVersion",
        "occurredAt",
        "localSequence",
        "balanceAfterRial",
        "operationResult",
        "snapshotVersion",
        "reversalOfLocalTransactionId"
      ],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "sourceInstanceId": { "type": "string", "format": "uuid" },
        "localTransactionId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceDatabase": { "type": "string", "minLength": 1, "maxLength": 160 },
        "organizationId": { "type": "string", "format": "uuid" },
        "branchId": { "type": "string", "format": "uuid" },
        "cardId": { "type": "string", "format": "uuid" },
        "householdId": { "type": "string", "format": "uuid" },
        "memberId": { "type": ["string", "null"], "format": "uuid" },
        "deviceId": { "type": ["string", "null"], "format": "uuid" },
        "sourceDeviceId": { "type": ["string", "null"], "maxLength": 160 },
        "attractionId": { "type": ["string", "null"], "format": "uuid" },
        "transactionKind": {
          "enum": ["top_up", "spend", "refund", "adjustment", "issuance", "card_replacement"]
        },
        "amountRial": { "type": "integer" },
        "currencyCode": { "const": "IRR" },
        "grossAmountRial": { "type": "integer", "minimum": 0 },
        "discountAmountRial": { "type": "integer", "minimum": 0 },
        "netAmountRial": { "type": "integer", "minimum": 0 },
        "promotionId": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
        "ruleId": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
        "pricingVersion": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "localSequence": { "type": "integer", "minimum": 1 },
        "balanceAfterRial": { "type": ["integer", "null"], "minimum": 0 },
        "operationResult": { "enum": ["success", "cancelled", "failed"] },
        "snapshotVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reversalOfLocalTransactionId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "EdgeEventBatchRequest": {
      "type": "object",
      "required": ["sourceInstanceId", "events"],
      "properties": {
        "sourceInstanceId": { "type": "string", "format": "uuid" },
        "events": { "type": "array", "minItems": 1, "maxItems": 100, "items": {} }
      },
      "additionalProperties": false
    },
    "EdgeIngestResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["eventId", "status", "errorCode", "retryable"],
          "properties": {
            "eventId": { "type": "string", "format": "uuid" },
            "status": { "const": "accepted" },
            "errorCode": { "const": null },
            "retryable": { "const": false }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["eventId", "status", "errorCode", "retryable"],
          "properties": {
            "eventId": { "type": "string", "format": "uuid" },
            "status": { "const": "duplicate" },
            "errorCode": { "const": null },
            "retryable": { "const": false }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["eventId", "status", "errorCode", "retryable"],
          "properties": {
            "eventId": { "type": ["string", "null"], "format": "uuid" },
            "status": { "const": "rejected" },
            "errorCode": {
              "enum": [
                "INVALID_EVENT",
                "INSTALLATION_NOT_AUTHORIZED",
                "INSTALLATION_SCOPE_MISMATCH",
                "RATE_LIMITED",
                "EVENT_CONFLICT",
                "TEMPORARY_UNAVAILABLE",
                "CARD_NOT_FOUND",
                "HOUSEHOLD_NOT_FOUND",
                "MEMBER_NOT_FOUND",
                "DEVICE_NOT_FOUND",
                "ATTRACTION_NOT_FOUND"
              ]
            },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "EdgeIngestResponse": {
      "type": "object",
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/EdgeIngestResult" }
        }
      },
      "additionalProperties": false
    },
    "EdgeCardMapping": {
      "type": "object",
      "required": ["cardId", "cardUidHash", "householdId", "memberId"],
      "properties": {
        "cardId": { "type": "string", "format": "uuid" },
        "cardUidHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "householdId": { "type": "string", "format": "uuid" },
        "memberId": { "type": ["string", "null"], "format": "uuid" }
      },
      "additionalProperties": false
    },
    "EdgeSnapshotItem": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["device", "card_mapping", "attraction", "setting"] },
        "value": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "EdgeSnapshotPage": {
      "type": "object",
      "required": [
        "snapshotId",
        "snapshotVersion",
        "branchId",
        "generatedAt",
        "validFrom",
        "validUntil",
        "documentHash",
        "pricing",
        "attractions",
        "settings",
        "items",
        "nextCursor",
        "signingKeyId",
        "signature"
      ],
      "properties": {
        "snapshotId": { "type": "string", "format": "uuid" },
        "snapshotVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "branchId": { "type": "string", "format": "uuid" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "documentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pricing": {
          "type": "object",
          "required": ["status", "version", "reasonCode", "rules"],
          "properties": {
            "status": { "const": "disabled" },
            "version": { "const": null },
            "reasonCode": { "const": "PENDING_WINDOWS_GOLDEN_VECTORS" },
            "rules": { "type": "array", "maxItems": 0, "items": {} }
          },
          "additionalProperties": false
        },
        "attractions": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "settings": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/EdgeSnapshotItem" } },
        "nextCursor": { "type": ["string", "null"], "maxLength": 2048 },
        "signingKeyId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "signature": { "type": "string", "pattern": "^sha256=[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "EdgeCardAssignmentRequest": {
      "type": "object",
      "required": ["cardId", "householdId", "expectedVersion", "reason"],
      "properties": {
        "cardId": { "type": "string", "format": "uuid" },
        "householdId": { "type": "string", "format": "uuid" },
        "memberId": { "type": ["string", "null"], "format": "uuid" },
        "expectedVersion": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 8, "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "EdgeCardCommandRequest": {
      "type": "object",
      "required": ["expectedVersion", "reason"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 8, "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "EdgeCardAssignmentResult": {
      "type": "object",
      "required": [
        "assignmentId",
        "cardId",
        "householdId",
        "memberId",
        "status",
        "verificationStatus",
        "maskedIdentifier"
      ],
      "properties": {
        "assignmentId": { "type": "string", "format": "uuid" },
        "cardId": { "type": "string", "format": "uuid" },
        "householdId": { "type": "string", "format": "uuid" },
        "memberId": { "type": ["string", "null"], "format": "uuid" },
        "status": { "const": "assigned" },
        "verificationStatus": { "const": "verified" },
        "maskedIdentifier": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "EdgeCardBlockResult": {
      "type": "object",
      "required": ["cardId", "status", "recordVersion", "maskedIdentifier"],
      "properties": {
        "cardId": { "type": "string", "format": "uuid" },
        "status": { "const": "blocked" },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "maskedIdentifier": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "EdgeCardReplacementRequestResult": {
      "type": "object",
      "required": ["requestId", "cardId", "status", "duplicate"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "cardId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["requested", "in_review", "approved"] },
        "duplicate": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "EdgeCustomerSearchQuery": {
      "type": "object",
      "required": ["branchId", "query"],
      "properties": {
        "branchId": { "type": "string", "format": "uuid" },
        "query": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cursor": { "type": "string", "format": "uuid" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "EdgeCustomerSearchItem": {
      "type": "object",
      "required": [
        "customerId",
        "displayName",
        "maskedPhone",
        "householdId",
        "memberId",
        "recordVersion"
      ],
      "properties": {
        "customerId": { "type": "string", "format": "uuid" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "maskedPhone": { "type": ["string", "null"], "maxLength": 24, "pattern": ".*[•*xX].*" },
        "householdId": { "type": "string", "format": "uuid" },
        "memberId": { "type": ["string", "null"], "format": "uuid" },
        "recordVersion": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "EdgeCustomerSearchPage": {
      "type": "object",
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/EdgeCustomerSearchItem" }
        },
        "nextCursor": { "type": ["string", "null"], "format": "uuid" }
      },
      "additionalProperties": false
    },
    "EdgeCustomerProfile": {
      "type": "object",
      "required": [
        "customerId",
        "firstName",
        "lastName",
        "birthDate",
        "gender",
        "city",
        "avatarPreset",
        "hasUploadedAvatar",
        "profileCompleted",
        "recordVersion",
        "maskedPhone"
      ],
      "properties": {
        "customerId": { "type": "string", "format": "uuid" },
        "firstName": { "type": ["string", "null"], "maxLength": 60 },
        "lastName": { "type": ["string", "null"], "maxLength": 60 },
        "birthDate": { "type": ["string", "null"], "format": "date" },
        "gender": {
          "type": ["string", "null"],
          "enum": ["female", "male", "other", "prefer_not_to_say", null]
        },
        "city": { "type": ["string", "null"], "maxLength": 80 },
        "avatarPreset": { "type": ["string", "null"], "maxLength": 32 },
        "hasUploadedAvatar": { "type": "boolean" },
        "profileCompleted": { "type": "boolean" },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "maskedPhone": { "type": ["string", "null"], "maxLength": 24, "pattern": ".*[•*xX].*" }
      },
      "additionalProperties": false
    },
    "EdgeCustomerProfilePatchRequest": {
      "type": "object",
      "required": ["branchId", "expectedVersion"],
      "minProperties": 3,
      "properties": {
        "branchId": { "type": "string", "format": "uuid" },
        "expectedVersion": { "type": "integer", "minimum": 1 },
        "firstName": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
        "lastName": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
        "birthDate": { "type": ["string", "null"], "format": "date" },
        "gender": {
          "type": ["string", "null"],
          "enum": ["female", "male", "other", "prefer_not_to_say", null]
        },
        "city": { "type": ["string", "null"], "maxLength": 80 },
        "avatarPreset": { "type": ["string", "null"], "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "EdgeHouseholdMember": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "relationship",
        "birthDate",
        "isDependent",
        "status",
        "recordVersion"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "displayName": { "type": "string", "maxLength": 80 },
        "relationship": { "type": "string", "maxLength": 40 },
        "birthDate": { "type": ["string", "null"], "format": "date" },
        "isDependent": { "type": "boolean" },
        "status": { "enum": ["active", "pending", "archived"] },
        "recordVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "EdgeHouseholdRead": {
      "type": "object",
      "required": ["id", "name", "status", "recordVersion", "members"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "enum": ["active", "suspended", "archived"] },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/EdgeHouseholdMember" }
        }
      },
      "additionalProperties": false
    },
    "EdgeHouseholdPatchRequest": {
      "type": "object",
      "required": ["branchId", "expectedVersion", "name"],
      "properties": {
        "branchId": { "type": "string", "format": "uuid" },
        "expectedVersion": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "EdgeHouseholdMemberCreateRequest": {
      "type": "object",
      "required": ["branchId", "displayName", "relationship"],
      "properties": {
        "branchId": { "type": "string", "format": "uuid" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "relationship": { "type": "string", "minLength": 2, "maxLength": 40 },
        "birthDate": { "type": ["string", "null"], "format": "date" },
        "isDependent": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "EdgeProfileMutationResult": {
      "type": "object",
      "required": ["customerId", "recordVersion", "maskedPhone"],
      "properties": {
        "customerId": { "type": "string", "format": "uuid" },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "maskedPhone": { "type": ["string", "null"], "maxLength": 24, "pattern": ".*[•*xX].*" }
      },
      "additionalProperties": false
    },
    "EdgeHouseholdMutationResult": {
      "type": "object",
      "required": ["householdId", "recordVersion"],
      "properties": {
        "householdId": { "type": "string", "format": "uuid" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "EdgeHouseholdMemberMutationResult": {
      "type": "object",
      "required": ["memberId", "householdId", "recordVersion"],
      "properties": {
        "memberId": { "type": "string", "format": "uuid" },
        "householdId": { "type": "string", "format": "uuid" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
