{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.funtino.ir/events/device/edge-transaction-payload.v2.json",
  "title": "Windows Edge transaction payload v2",
  "type": "object",
  "required": ["eventId", "sourceInstanceId", "localTransactionId", "sourceDatabase", "organizationId", "branchId", "cardId", "householdId", "deviceId", "sourceDeviceId", "transactionKind", "amountRial", "currencyCode", "grossAmountRial", "discountAmountRial", "netAmountRial", "promotionId", "ruleId", "pricingVersion", "occurredAt", "localSequence", "balanceAfterRial", "operationResult", "snapshotVersion"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "sourceInstanceId": { "type": "string", "format": "uuid" },
    "localTransactionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sourceDatabase": { "type": "string", "minLength": 1, "maxLength": 160 },
    "organizationId": { "type": "string", "format": "uuid" },
    "branchId": { "type": "string", "format": "uuid" },
    "cardId": { "type": "string", "format": "uuid" },
    "householdId": { "type": "string", "format": "uuid" },
    "memberId": { "type": ["string", "null"], "format": "uuid" },
    "deviceId": { "type": ["string", "null"], "format": "uuid" },
    "sourceDeviceId": { "type": ["string", "null"], "maxLength": 160 },
    "transactionKind": { "enum": ["top_up", "spend", "refund", "adjustment", "issuance", "card_replacement"] },
    "amountRial": { "type": "integer" },
    "currencyCode": { "const": "IRR" },
    "grossAmountRial": { "type": "integer", "minimum": 0 },
    "discountAmountRial": { "type": "integer", "minimum": 0 },
    "netAmountRial": { "type": "integer", "minimum": 0 },
    "promotionId": { "type": ["string", "null"], "maxLength": 160 },
    "ruleId": { "type": ["string", "null"], "maxLength": 160 },
    "pricingVersion": { "type": ["string", "null"], "maxLength": 80 },
    "reversalOfLocalTransactionId": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "localSequence": { "type": "integer", "minimum": 1 },
    "balanceAfterRial": { "type": ["integer", "null"], "minimum": 0 },
    "operationResult": { "enum": ["success", "cancelled", "failed"] },
    "snapshotVersion": { "type": "string", "minLength": 1, "maxLength": 120 }
  },
  "additionalProperties": false
}
