{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.funtino.ir/events/forms/response-submitted.v1.schema.json",
  "title": "Form response submitted event v1",
  "allOf": [
    { "$ref": "../common/envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "forms.response-submitted.v1" },
        "payload": {
          "type": "object",
          "required": ["responseId", "formId", "formVersionId", "organizationId", "branchId"],
          "properties": {
            "responseId": { "type": "string", "format": "uuid" },
            "formId": { "type": "string", "format": "uuid" },
            "formVersionId": { "type": "string", "format": "uuid" },
            "organizationId": { "type": "string", "format": "uuid" },
            "branchId": { "type": "string", "format": "uuid" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
