{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.funtino.ir/events/forms/form-paused.v1.schema.json",
  "title": "Form paused event v1",
  "allOf": [
    { "$ref": "../common/envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "forms.form-paused.v1" },
        "payload": {
          "type": "object",
          "required": ["formId", "organizationId", "branchId", "version"],
          "properties": {
            "formId": { "type": "string", "format": "uuid" },
            "organizationId": { "type": "string", "format": "uuid" },
            "branchId": { "type": "string", "format": "uuid" },
            "version": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
