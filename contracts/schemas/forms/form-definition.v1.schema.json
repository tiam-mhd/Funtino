{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.funtino.ir/schemas/forms/form-definition.v1.schema.json",
  "title": "Funtino form definition v1",
  "type": "object",
  "required": ["schemaVersion", "title", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 1500, "default": "" },
    "welcomeTitle": { "type": "string", "maxLength": 160, "default": "" },
    "welcomeMessage": { "type": "string", "maxLength": 1000, "default": "" },
    "successMessage": { "type": "string", "maxLength": 1000 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/Page" }
    },
    "theme": { "$ref": "#/$defs/Theme" }
  },
  "additionalProperties": false,
  "$defs": {
    "Option": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "Condition": {
      "type": "object",
      "required": ["fieldId", "operator"],
      "properties": {
        "fieldId": { "type": "string", "format": "uuid" },
        "operator": { "enum": ["answered", "equals", "not_equals", "contains", "greater_than", "less_than"] },
        "value": {}
      },
      "allOf": [{
        "if": { "properties": { "operator": { "const": "answered" } }, "required": ["operator"] },
        "then": {},
        "else": { "required": ["value"] }
      }],
      "additionalProperties": false
    },
    "Validation": {
      "type": "object",
      "properties": {
        "minLength": { "type": "integer", "minimum": 0, "maximum": 4000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "errorMessage": { "type": "string", "maxLength": 240 }
      },
      "additionalProperties": false
    },
    "Field": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "enum": ["short_text", "long_text", "full_name", "phone", "email", "number", "money", "date", "time", "single_choice", "multiple_choice", "dropdown", "yes_no", "rating", "nps", "slider", "ranking", "matrix", "consent", "heading", "paragraph", "hidden"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "helpText": { "type": "string", "maxLength": 500 },
        "placeholder": { "type": "string", "maxLength": 160 },
        "required": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "searchable": { "type": "boolean" },
        "defaultValue": {},
        "options": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/Option" } },
        "rows": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/Option" } },
        "validation": { "$ref": "#/$defs/Validation" },
        "condition": { "$ref": "#/$defs/Condition" },
        "prefillKey": { "enum": ["source", "campaign", "ref"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["single_choice", "multiple_choice", "dropdown", "ranking"] } }, "required": ["type"] }, "then": { "properties": { "options": { "type": "array", "minItems": 2 } }, "required": ["options"] } },
        { "if": { "properties": { "type": { "const": "matrix" } }, "required": ["type"] }, "then": { "properties": { "options": { "type": "array", "minItems": 2 }, "rows": { "type": "array", "minItems": 1 } }, "required": ["options", "rows"] } },
        { "if": { "properties": { "type": { "const": "hidden" } }, "required": ["type"] }, "then": { "required": ["prefillKey"] }, "else": { "not": { "required": ["prefillKey"] } } },
        { "if": { "properties": { "type": { "enum": ["full_name", "phone", "email"] } }, "required": ["type"] }, "then": { "properties": { "sensitive": { "const": true } }, "required": ["sensitive"] } }
      ],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "required": ["id", "title", "fields"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "condition": { "$ref": "#/$defs/Condition" },
        "fields": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Field" } }
      },
      "additionalProperties": false
    },
    "Theme": {
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surfaceColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "font": { "enum": ["vazirmatn", "estedad"] },
        "cornerStyle": { "enum": ["soft", "rounded", "pill"] },
        "layout": { "enum": ["paged", "single"] },
        "showProgress": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
