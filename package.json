{
  "name": "funtino",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@funtino/customer-web",
    "dev:customer": "turbo dev --filter=@funtino/customer-web",
    "dev:operations": "turbo dev --filter=@funtino/operations-web",
    "dev:system": "turbo dev --filter=@funtino/system-web",
    "dev:api": "turbo dev --filter=@funtino/api-gateway",
    "dev:realtime": "turbo dev --filter=@funtino/realtime-gateway",
    "dev:device": "turbo dev --filter=@funtino/device-integration",
    "dev:wallet": "turbo dev --filter=@funtino/wallet",
    "dev:customer-household": "turbo dev --filter=@funtino/customer-household",
    "dev:notifications": "turbo dev --filter=@funtino/notifications",
    "dev:identity": "turbo dev --filter=@funtino/identity-access",
    "dev:organization-branch": "turbo dev --filter=@funtino/organization-branch",
    "dev:analytics": "turbo dev --filter=@funtino/analytics-read-model",
    "backend:build": "turbo run build --filter=@funtino/api-gateway --filter=@funtino/realtime-gateway --filter=@funtino/device-integration --filter=@funtino/wallet --filter=@funtino/customer-household --filter=@funtino/notifications --filter=@funtino/identity-access --filter=@funtino/organization-branch --filter=@funtino/analytics-read-model --filter=@funtino/backend-core --filter=@funtino/event-contracts",
    "build": "turbo run build --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format:check": "node scripts/quality/check-changed-format.mjs",
    "format:all:check": "prettier --check .",
    "runtime:export": "node scripts/deployment/export-runflare-bundles.mjs all",
    "runtime:export:frontend": "node scripts/deployment/export-runflare-bundles.mjs frontend",
    "runtime:export:backend": "node scripts/deployment/export-runflare-bundles.mjs backend",
    "test:e2e:scope": "node tests/e2e/scope-security.smoke.mjs",
    "test:e2e:a11y": "node tests/e2e/accessibility.audit.mjs",
    "contracts:check": "node scripts/quality/validate-contracts.mjs",
    "monitoring:config:check": "node scripts/quality/validate-monitoring-config.mjs",
    "database:restore-smoke": "node scripts/database/backup-restore-smoke.mjs",
    "quality:ci": "pnpm format:check && pnpm contracts:check && pnpm monitoring:config:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e:scope",
    "format": "prettier --write .",
    "backend:typecheck": "turbo run typecheck --filter=@funtino/api-gateway --filter=@funtino/realtime-gateway --filter=@funtino/device-integration --filter=@funtino/wallet --filter=@funtino/customer-household --filter=@funtino/notifications --filter=@funtino/identity-access --filter=@funtino/organization-branch --filter=@funtino/analytics-read-model --filter=@funtino/backend-core --filter=@funtino/event-contracts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "axe-core": "4.13.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.22.0",
    "eslint-config-next": "15.5.2",
    "js-yaml": "4.3.2",
    "prettier": "3.5.3",
    "turbo": "2.4.4",
    "typescript": "5.8.2"
  }
}
