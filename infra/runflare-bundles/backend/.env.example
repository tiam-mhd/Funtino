# Set real values as Runflare runtime Environment/Secret, never in this file.
# DATABASE_MIGRATION_URL and DEVICE_INTEGRATION_MIGRATION_DATABASE_URL are one-off migration inputs, not process runtime env.
NODE_ENV=production
APP_VERSION=

# API Gateway
API_PORT=4000
API_METRICS_TOKEN=
CORS_ORIGINS=https://app.funtino.ir,https://web.funtino.ir,https://admin.funtino.ir
API_BASE_URL=https://api.funtino.ir
STORAGE_MODE=postgres
DATABASE_URL=
DATABASE_MIGRATION_URL=
RABBITMQ_URL=
REDIS_URL=
PROMETHEUS_INTERNAL_URL=
SESSION_COOKIE_DOMAIN=.funtino.ir
EXPOSE_DEV_OTP=false
PARSGREEN_API_TOKEN=
PARSGREEN_AUTH_HEADER=Authorization
PARSGREEN_OTP_URL=https://sms.parsgreen.ir/Apiv2/Message/SendOtp
PARSGREEN_OTP_TEMPLATE_ID=
PARSGREEN_ADD_NAME=false
PARSGREEN_REQUEST_TIMEOUT_MS=8000
# Gateway -> Identity & Access ClusterIP name; use the exact Runflare network name (Port 80 -> Target Port 4040).
IDENTITY_ACCESS_URL=http://<identity-access-clusterip-network-name>:80
IDENTITY_ACCESS_SERVICE_TOKEN=
ORGANIZATION_BRANCH_URL=
ORGANIZATION_BRANCH_INTERNAL_URL=
ORGANIZATION_BRANCH_GATEWAY_TOKEN=
DEVICE_INTEGRATION_URL=
DEVICE_INTEGRATION_GATEWAY_TOKEN=
DEVICE_INTEGRATION_ORGANIZATION_BRANCH_TOKEN=
WALLET_URL=
WALLET_GATEWAY_TOKEN=
CUSTOMER_HOUSEHOLD_URL=
CUSTOMER_HOUSEHOLD_GATEWAY_TOKEN=
CUSTOMER_FAMILY_PHONE_HASH_SECRET=
ANALYTICS_READ_MODEL_URL=
ANALYTICS_API_GATEWAY_TOKEN=

# Realtime Gateway
REALTIME_PORT=4010
REALTIME_METRICS_TOKEN=

# Device Integration
DEVICE_PORT=4020
DEVICE_INTEGRATION_METRICS_TOKEN=
DEVICE_INTEGRATION_DATABASE_URL=
DEVICE_INTEGRATION_MIGRATION_DATABASE_URL=
DEVICE_WEBHOOK_SECRET=
DEVICE_HEALTH_STALE_AFTER_SECONDS=
DEVICE_HEALTH_OFFLINE_AFTER_SECONDS=

# Notifications
NOTIFICATIONS_PORT=4030
NOTIFICATIONS_METRICS_TOKEN=

# Identity & Access
IDENTITY_ACCESS_PORT=4040
IDENTITY_ACCESS_DATABASE_URL=
IDENTITY_ACCESS_MIGRATION_DATABASE_URL=
IDENTITY_ACCESS_MANAGEMENT_WRITES_ENABLED=false
IDENTITY_ACCESS_METRICS_TOKEN=
ORGANIZATION_BRANCH_IDENTITY_ACCESS_TOKEN=
IDENTITY_ACCESS_MFA_ACTIVE_KEY_VERSION=
IDENTITY_ACCESS_MFA_ENCRYPTION_KEYS=
IDENTITY_ACCESS_LOOKUP_ACTIVE_KEY_VERSION=
IDENTITY_ACCESS_LOOKUP_HMAC_KEYS=

# Organization & Branch
ORGANIZATION_BRANCH_PORT=4050
ORGANIZATION_BRANCH_DATABASE_URL=
ORGANIZATION_BRANCH_MIGRATION_DATABASE_URL=
ORGANIZATION_BRANCH_METRICS_TOKEN=
ORGANIZATION_BRANCH_DEVICE_INTEGRATION_TOKEN=
ORGANIZATION_BRANCH_WALLET_TOKEN=

# Analytics Read Model
ANALYTICS_PORT=4060
ANALYTICS_DATABASE_URL=
ANALYTICS_MIGRATION_DATABASE_URL=
ANALYTICS_METRICS_TOKEN=

# Wallet
WALLET_PORT=4070
WALLET_DATABASE_URL=
WALLET_MIGRATION_DATABASE_URL=
