NODE_ENV=development
ORGANIZATION_BRANCH_PORT=4050
ORGANIZATION_BRANCH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=organization_branch
ORGANIZATION_BRANCH_MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB?schema=organization_branch
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/%2f

# Metrics token is required in production (unique per service/environment, at least 32 random characters).
# Keep each caller token separate and configure the matching pair only in private runtime secrets.
ORGANIZATION_BRANCH_METRICS_TOKEN=
ORGANIZATION_BRANCH_GATEWAY_TOKEN=
ORGANIZATION_BRANCH_IDENTITY_ACCESS_TOKEN=
ORGANIZATION_BRANCH_DEVICE_INTEGRATION_TOKEN=
ORGANIZATION_BRANCH_WALLET_TOKEN=

# Docker startup requires both database URLs, prepares this schema, and applies pending migrations before this Worker starts.
# In deployment keep both URLs in private secrets for the same database/schema; grant DDL only to the migration URL.
# Legacy backfill credentials/approval flags are deliberately excluded from runtime configuration.
