{
  "name": "@funtino/organization-branch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prisma:generate && tsx watch src/main.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json && node -e \"require('node:fs').accessSync('dist/main.js')\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm prisma:generate && pnpm --filter @funtino/event-contracts build && pnpm --filter @funtino/backend-core build && tsx --test tests/organization-branch.service.spec.ts tests/outbox-relay.spec.ts tests/device-service-token.guard.spec.ts tests/startup-failure.spec.ts && node --test ../../scripts/worker-startup.spec.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:schema": "prisma db execute --schema prisma/schema.prisma --file prisma/bootstrap.sql",
    "prisma:bootstrap": "pnpm prisma:migrate",
    "prisma:migrate": "pnpm prisma:schema && prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "backfill:legacy": "pnpm prisma:generate && tsx src/bootstrap/legacy-backfill.cli.ts"
  },
  "dependencies": {
    "@funtino/backend-core": "workspace:*",
    "@funtino/event-contracts": "workspace:*",
    "@nestjs/common": "11.0.11",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-fastify": "11.0.11",
    "@prisma/client": "6.7.0",
    "fastify": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "prisma": "6.7.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
