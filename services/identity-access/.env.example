NODE_ENV=development
IDENTITY_ACCESS_PORT=4040
IDENTITY_ACCESS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=identity_access
IDENTITY_ACCESS_MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB?schema=identity_access
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/%2f
# In Runflare production, use the exact ClusterIP network alias on Port 80.
ORGANIZATION_BRANCH_URL=http://organization-branch:4050
IDENTITY_ACCESS_MANAGEMENT_WRITES_ENABLED=false

# Required in production, unique per service/environment, and at least 32 random characters.
IDENTITY_ACCESS_SERVICE_TOKEN=
IDENTITY_ACCESS_METRICS_TOKEN=
ORGANIZATION_BRANCH_IDENTITY_ACCESS_TOKEN=
IDENTITY_ACCESS_MFA_ACTIVE_KEY_VERSION=
IDENTITY_ACCESS_MFA_ENCRYPTION_KEYS=
IDENTITY_ACCESS_LOOKUP_ACTIVE_KEY_VERSION=
IDENTITY_ACCESS_LOOKUP_HMAC_KEYS=

# Docker startup requires both database URLs, prepares this schema, and applies pending migrations before IAM starts.
# In deployment keep both URLs in private secrets for the same database/schema; grant DDL only to the migration URL.
# IDENTITY_ACCESS_BOOTSTRAP_ENABLED is intentionally omitted; it is a one-shot CLI-only flag.
