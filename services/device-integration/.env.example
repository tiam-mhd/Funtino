DEVICE_PORT=4020
DEVICE_INTEGRATION_METRICS_TOKEN=
DEVICE_INTEGRATION_DATABASE_URL=
DEVICE_INTEGRATION_MIGRATION_DATABASE_URL=
DEVICE_INTEGRATION_GATEWAY_TOKEN=
# Same dedicated >=32-character secret configured as EDGE_OPERATOR_PAIRING_DEVICE_INTEGRATION_TOKEN in API Gateway.
DEVICE_INTEGRATION_EDGE_OPERATOR_PAIRING_TOKEN=
API_GATEWAY_INTERNAL_URL=http://<api-gateway-clusterip-network-name>:80
DEVICE_WEBHOOK_SECRET=
IDENTITY_ACCESS_URL=http://<identity-access-clusterip-network-name>:80
DEVICE_INTEGRATION_IDENTITY_ACCESS_TOKEN=
CUSTOMER_HOUSEHOLD_INTERNAL_URL=http://<customer-household-clusterip-network-name>:80
DEVICE_INTEGRATION_CUSTOMER_HOUSEHOLD_TOKEN=
WALLET_URL=http://<wallet-clusterip-network-name>:80
WALLET_DEVICE_INTEGRATION_TOKEN=
# JSON object mapping installation key IDs to HMAC secrets; also signs snapshot pages and cursors.
DEVICE_EDGE_HMAC_KEYS={}
# In Runflare production, use the exact ClusterIP network alias on Port 80.
ORGANIZATION_BRANCH_INTERNAL_URL=http://localhost:4050
DEVICE_INTEGRATION_ORGANIZATION_BRANCH_TOKEN=
RABBITMQ_URL=amqp://localhost:5672
DEVICE_HEALTH_STALE_AFTER_SECONDS=300
DEVICE_HEALTH_OFFLINE_AFTER_SECONDS=900
