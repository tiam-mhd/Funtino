generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DEVICE_INTEGRATION_DATABASE_URL")
  directUrl = env("DEVICE_INTEGRATION_MIGRATION_DATABASE_URL")
  schemas   = ["device_integration"]
}

enum DeviceType {
  rfid_reader
  terminal
  access_gate
  other

  @@map("device_type")
  @@schema("device_integration")
}

enum DeviceStatus {
  active
  suspended
  retired

  @@map("device_status")
  @@schema("device_integration")
}

enum ReportedHealthState {
  online
  degraded
  offline

  @@map("reported_health_state")
  @@schema("device_integration")
}

enum EdgeInstallationStatus {
  active
  suspended
  revoked

  @@map("edge_installation_status")
  @@schema("device_integration")
}

model Device {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  branchId            String              @map("branch_id") @db.Uuid
  adapterKey          String              @map("adapter_key") @db.VarChar(60)
  externalDeviceId    String              @map("external_device_id") @db.VarChar(160)
  displayName         String              @map("display_name") @db.VarChar(120)
  deviceType          DeviceType          @map("device_type")
  status              DeviceStatus        @default(active)
  latestReportedState ReportedHealthState? @map("latest_reported_state")
  latestObservedAt    DateTime?           @map("latest_observed_at") @db.Timestamptz(6)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  healthObservations  DeviceHealthObservation[]

  @@unique([organizationId, adapterKey, externalDeviceId], map: "devices_org_adapter_external_id_key")
  @@index([organizationId, branchId, id], map: "devices_org_branch_id_idx")
  @@index([organizationId, branchId, status, id], map: "devices_org_branch_status_id_idx")
  @@map("devices")
  @@schema("device_integration")
}

model DeviceHealthObservation {
  id                    String              @id @db.Uuid
  deviceId              String              @map("device_id") @db.Uuid
  externalObservationId String              @map("external_observation_id") @db.VarChar(160)
  requestHash           String              @map("request_hash") @db.Char(64)
  reportedState         ReportedHealthState @map("reported_state")
  observedAt            DateTime            @map("observed_at") @db.Timestamptz(6)
  receivedAt            DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  correlationId         String              @map("correlation_id") @db.Uuid
  appliedAsLatest       Boolean             @map("applied_as_latest")
  device                Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([deviceId, externalObservationId], map: "device_health_observations_device_external_id_key")
  @@index([deviceId, observedAt, id], map: "device_health_observations_device_observed_idx")
  @@map("device_health_observations")
  @@schema("device_integration")
}

model DeviceTransactionImport {
  externalEventId String   @id @map("external_event_id") @db.VarChar(160)
  transactionId   String   @unique(map: "device_transaction_imports_transaction_id_key") @map("transaction_id") @db.Uuid
  requestHash     String   @map("request_hash") @db.Char(64)
  organizationId  String   @map("organization_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  sourceDeviceId  String?  @map("source_device_id") @db.VarChar(160)
  deviceId        String?  @map("device_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([organizationId, branchId, receivedAt], map: "device_transaction_imports_scope_received_idx")
  @@map("device_transaction_imports")
  @@schema("device_integration")
}

model EdgeInstallation {
  sourceInstanceId String                 @id @map("source_instance_id") @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  branchId         String                 @map("branch_id") @db.Uuid
  currentKeyId     String                 @map("current_key_id") @db.VarChar(120)
  previousKeyId    String?                @map("previous_key_id") @db.VarChar(120)
  status           EdgeInstallationStatus @default(active)
  version          Int                    @default(1)
  lastHeartbeatAt  DateTime?              @map("last_heartbeat_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, branchId, sourceInstanceId], map: "edge_installations_scope_instance_key")
  @@index([organizationId, branchId, status], map: "edge_installations_scope_status_idx")
  @@map("edge_installations")
  @@schema("device_integration")
}

model EdgeTransactionImport {
  eventId            String   @id @map("event_id") @db.Uuid
  sourceInstanceId   String   @map("source_instance_id") @db.Uuid
  localTransactionId String   @map("local_transaction_id") @db.VarChar(160)
  localSequence      BigInt   @map("local_sequence")
  requestHash        String   @map("request_hash") @db.Char(64)
  organizationId     String   @map("organization_id") @db.Uuid
  branchId           String   @map("branch_id") @db.Uuid
  eventPayload       Json     @map("event_payload")
  receivedAt         DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([sourceInstanceId, localTransactionId], map: "edge_transaction_imports_instance_local_key")
  @@unique([sourceInstanceId, localSequence], map: "edge_transaction_imports_instance_sequence_key")
  @@index([organizationId, branchId, receivedAt], map: "edge_transaction_imports_scope_received_idx")
  @@map("edge_transaction_imports")
  @@schema("device_integration")
}

model EdgeRateLimit {
  sourceInstanceId String   @map("source_instance_id") @db.Uuid
  windowStartedAt  DateTime @map("window_started_at") @db.Timestamptz(0)
  requestCount     Int      @default(0) @map("request_count")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([sourceInstanceId, windowStartedAt])
  @@map("edge_rate_limits")
  @@schema("device_integration")
}

model EdgeInstallationAudit {
  id               String   @id @db.Uuid
  sourceInstanceId String   @map("source_instance_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  actorUserId      String   @map("actor_user_id") @db.Uuid
  callerService    String   @map("caller_service") @db.VarChar(80)
  action           String   @db.VarChar(80)
  correlationId    String   @map("correlation_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  before           Json?
  after            Json

  @@index([sourceInstanceId, createdAt], map: "edge_installation_audit_instance_created_idx")
  @@index([organizationId, branchId, createdAt], map: "edge_installation_audit_scope_created_idx")
  @@map("edge_installation_audit")
  @@schema("device_integration")
}

model EdgeSnapshot {
  id               String   @id @db.Uuid
  sourceInstanceId String   @map("source_instance_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  version          String   @db.VarChar(120)
  document         Json
  documentHash     String   @map("document_hash") @db.Char(64)
  validFrom        DateTime @map("valid_from") @db.Timestamptz(6)
  validUntil       DateTime @map("valid_until") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceInstanceId, version], map: "edge_snapshots_instance_version_key")
  @@index([sourceInstanceId, branchId, createdAt], map: "edge_snapshots_instance_created_idx")
  @@index([validUntil], map: "edge_snapshots_valid_until_idx")
  @@map("edge_snapshots")
  @@schema("device_integration")
}

model DeviceAuditLog {
  id             String   @id @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  callerService  String   @map("caller_service") @db.VarChar(80)
  action         String   @db.VarChar(120)
  deviceId       String   @map("device_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  correlationId String   @map("correlation_id") @db.Uuid
  reason         String?  @db.VarChar(500)
  before         Json?
  after          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([deviceId, createdAt], map: "device_audit_logs_device_created_idx")
  @@index([organizationId, branchId, createdAt], map: "device_audit_logs_scope_created_idx")
  @@index([actorUserId, createdAt], map: "device_audit_logs_actor_created_idx")
  @@map("device_audit_logs")
  @@schema("device_integration")
}

model IdempotencyCommand {
  callerService String   @map("caller_service") @db.VarChar(80)
  key           String   @db.Uuid
  requestHash   String   @map("request_hash") @db.Char(64)
  response      Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([callerService, key])
  @@index([createdAt], map: "idempotency_commands_created_idx")
  @@map("idempotency_commands")
  @@schema("device_integration")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(160)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  envelope       Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  leaseToken     String?   @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(80)

  @@index([publishedAt, deadLetteredAt, availableAt, createdAt], map: "outbox_events_delivery_idx")
  @@map("outbox_events")
  @@schema("device_integration")
}

model EdgeOutboxReplayAudit {
  id               String   @id @db.Uuid
  outboxEventId    String   @map("outbox_event_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  sourceInstanceId String   @map("source_instance_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  actorUserId      String   @map("actor_user_id") @db.Uuid
  callerService    String   @map("caller_service") @db.VarChar(80)
  correlationId    String   @map("correlation_id") @db.Uuid
  idempotencyKey   String   @unique(map: "edge_outbox_replay_audits_idempotency_key") @map("idempotency_key") @db.Uuid
  reason           String   @db.VarChar(500)
  previousErrorCode String? @map("previous_error_code") @db.VarChar(80)
  previousAttempts Int      @map("previous_attempts")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, branchId, createdAt], map: "edge_outbox_replay_audits_scope_created_idx")
  @@index([eventId, createdAt], map: "edge_outbox_replay_audits_event_created_idx")
  @@map("edge_outbox_replay_audits")
  @@schema("device_integration")
}
