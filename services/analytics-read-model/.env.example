NODE_ENV=development
ANALYTICS_PORT=4060
ANALYTICS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=analytics_read_model
ANALYTICS_MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB?schema=analytics_read_model
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/%2f
DEVICE_HEALTH_STALE_AFTER_SECONDS=300
DEVICE_HEALTH_OFFLINE_AFTER_SECONDS=900

# Metrics token is required in production (unique per service/environment, at least 32 random characters).
# Keep the Gateway caller token separate and configure runtime values only in private secrets.
ANALYTICS_METRICS_TOKEN=
ANALYTICS_API_GATEWAY_TOKEN=

# Docker startup requires both database URLs, prepares this schema, and applies pending migrations before Analytics starts.
# In deployment keep both URLs in private secrets for the same database/schema; grant DDL only to the migration URL.
