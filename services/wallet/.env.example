NODE_ENV=development
WALLET_PORT=4070
WALLET_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=wallet
WALLET_MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB?schema=wallet
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/%2f
# In Runflare production, use each exact ClusterIP network alias on Port 80.
WALLET_ORGANIZATION_BRANCH_INTERNAL_URL=http://organization-branch:4050
WALLET_CUSTOMER_HOUSEHOLD_INTERNAL_URL=http://customer-household:4080

# Metrics token is required in production (unique per service/environment, at least 32 random characters).
# Keep each caller token separate and configure the matching pair only in private runtime secrets.
WALLET_METRICS_TOKEN=
WALLET_GATEWAY_TOKEN=
WALLET_ORGANIZATION_BRANCH_TOKEN=
WALLET_CUSTOMER_HOUSEHOLD_TOKEN=

# Docker startup requires both database URLs, prepares this schema, and applies pending migrations before Wallet starts.
# In deployment keep both URLs in private secrets for the same database/schema; grant DDL only to the migration URL.
