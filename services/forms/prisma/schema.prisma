generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("FORMS_DATABASE_URL")
  directUrl = env("FORMS_MIGRATION_DATABASE_URL")
  schemas   = ["forms"]
}

enum FormStatus {
  draft
  published
  paused
  archived

  @@map("form_status")
  @@schema("forms")
}

enum FormAccessMode {
  guest
  optional_auth
  auth_required

  @@map("form_access_mode")
  @@schema("forms")
}

enum ResponseStatus {
  new
  in_review
  followed_up
  closed
  spam

  @@map("response_status")
  @@schema("forms")
}

enum TemplateScopeType {
  global
  organization
  branch

  @@map("template_scope_type")
  @@schema("forms")
}

model Form {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  slug            String         @unique @db.VarChar(100)
  title           String         @db.VarChar(160)
  description     String         @default("") @db.VarChar(1500)
  status          FormStatus     @default(draft)
  accessMode      FormAccessMode @default(guest) @map("access_mode")
  linkEnabled     Boolean        @default(false) @map("link_enabled")
  startsAt        DateTime?      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?      @map("ends_at") @db.Timestamptz(6)
  responseLimit   Int?           @map("response_limit")
  responseCount   Int            @default(0) @map("response_count")
  currentVersion  Int?           @map("current_version")
  draftSchema     Json           @map("draft_schema") @db.JsonB
  templateId      String?        @map("template_id") @db.Uuid
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  updatedByUserId String         @map("updated_by_user_id") @db.Uuid
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions        FormVersion[]
  responses       FormResponse[]

  @@index([organizationId, branchId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("forms")
  @@schema("forms")
}

model FormVersion {
  id            String         @id @default(uuid()) @db.Uuid
  formId        String         @map("form_id") @db.Uuid
  version       Int
  schemaVersion Int            @map("schema_version")
  definition    Json           @db.JsonB
  publishedById String         @map("published_by_id") @db.Uuid
  publishedAt   DateTime       @default(now()) @map("published_at") @db.Timestamptz(6)
  form          Form           @relation(fields: [formId], references: [id], onDelete: Restrict)
  responses     FormResponse[]

  @@unique([formId, version])
  @@index([formId, publishedAt])
  @@map("form_versions")
  @@schema("forms")
}

model FormResponse {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  branchId          String             @map("branch_id") @db.Uuid
  formId            String             @map("form_id") @db.Uuid
  formVersionId     String             @map("form_version_id") @db.Uuid
  customerId        String?            @map("customer_id") @db.Uuid
  customerConsentAt DateTime?          @map("customer_consent_at") @db.Timestamptz(6)
  idempotencyKey    String             @map("idempotency_key") @db.VarChar(80)
  payloadHash       String             @map("payload_hash") @db.Char(64)
  answers           Json               @db.JsonB
  status            ResponseStatus     @default(new)
  tags              String[]           @default([])
  correctionVersion Int                @default(0) @map("correction_version")
  submittedAt       DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  form              Form               @relation(fields: [formId], references: [id], onDelete: Restrict)
  formVersion       FormVersion        @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  notes             FormResponseNote[]
  corrections       FormResponseCorrection[]

  @@unique([formId, idempotencyKey])
  @@index([organizationId, branchId, formId, submittedAt])
  @@index([organizationId, formId, status, submittedAt])
  @@map("form_responses")
  @@schema("forms")
}

model FormResponseCorrection {
  id                String       @id @default(uuid()) @db.Uuid
  responseId        String       @map("response_id") @db.Uuid
  fieldId           String       @map("field_id") @db.Uuid
  correctionVersion Int          @map("correction_version")
  previousPresent   Boolean      @map("previous_present")
  previousValue     Json         @map("previous_value") @db.JsonB
  newPresent        Boolean      @map("new_present")
  newValue          Json         @map("new_value") @db.JsonB
  reason            String       @db.VarChar(500)
  actorUserId       String       @map("actor_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  response          FormResponse @relation(fields: [responseId], references: [id], onDelete: Restrict)

  @@unique([responseId, correctionVersion, fieldId])
  @@index([responseId, createdAt])
  @@map("form_response_corrections")
  @@schema("forms")
}

model FormResponseNote {
  id           String       @id @default(uuid()) @db.Uuid
  responseId   String       @map("response_id") @db.Uuid
  authorUserId String       @map("author_user_id") @db.Uuid
  body         String       @db.VarChar(2000)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  response     FormResponse @relation(fields: [responseId], references: [id], onDelete: Restrict)

  @@index([responseId, createdAt])
  @@map("form_response_notes")
  @@schema("forms")
}

model FormTemplate {
  id              String           @id @default(uuid()) @db.Uuid
  scopeType       TemplateScopeType @default(global) @map("scope_type")
  organizationId  String?          @map("organization_id") @db.Uuid
  branchId        String?          @map("branch_id") @db.Uuid
  name            String           @db.VarChar(120)
  description     String           @default("") @db.VarChar(500)
  definition      Json             @db.JsonB
  enabled         Boolean          @default(true)
  version         Int              @default(1)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  updatedByUserId String           @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scopeType, organizationId, branchId, enabled, name])
  @@map("form_templates")
  @@schema("forms")
}

model FormPlatformSettings {
  id              Int      @id @default(1)
  defaultTheme    Json     @map("default_theme") @db.JsonB
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("form_platform_settings")
  @@schema("forms")
}

model FormAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(80)
  targetType     String   @map("target_type") @db.VarChar(40)
  targetId       String   @map("target_id") @db.VarChar(80)
  organizationId String?  @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  reason         String?  @db.VarChar(500)
  metadata       Json?    @db.JsonB
  correlationId  String?  @map("correlation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@map("form_audit_logs")
  @@schema("forms")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(160)
  eventVersion   Int       @map("event_version")
  aggregateId    String    @map("aggregate_id") @db.VarChar(160)
  envelope       Json      @db.JsonB
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken     String?   @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(80)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, deadLetteredAt, availableAt, createdAt])
  @@map("outbox_events")
  @@schema("forms")
}
