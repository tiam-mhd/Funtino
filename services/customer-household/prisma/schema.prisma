generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("CUSTOMER_HOUSEHOLD_DATABASE_URL")
  directUrl = env("CUSTOMER_HOUSEHOLD_MIGRATION_DATABASE_URL")
  schemas   = ["customer_household"]
}

enum HouseholdStatus {
  active
  suspended
  archived

  @@map("household_status")
  @@schema("customer_household")
}

enum HouseholdAccessRole {
  owner
  guardian
  member

  @@map("household_access_role")
  @@schema("customer_household")
}

enum HouseholdAccessStatus {
  active
  suspended
  revoked

  @@map("household_access_status")
  @@schema("customer_household")
}

enum HouseholdMemberStatus {
  active
  pending
  archived

  @@map("household_member_status")
  @@schema("customer_household")
}

enum HouseholdMemberGender {
  female
  male
  unspecified

  @@map("household_member_gender")
  @@schema("customer_household")
}

enum HouseholdRelationshipKind {
  parent_of
  spouse_of
  sibling_of
  guardian_of

  @@map("household_relationship_kind")
  @@schema("customer_household")
}

enum HouseholdRelationshipBasis {
  biological
  legal
  adoptive
  step
  partner
  unspecified

  @@map("household_relationship_basis")
  @@schema("customer_household")
}

enum HouseholdInvitationKind {
  adult_account
  dependent_claim

  @@map("household_invitation_kind")
  @@schema("customer_household")
}

enum HouseholdInvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
  claim_pending
  linked
  conflict_review

  @@map("household_invitation_status")
  @@schema("customer_household")
}

model Household {
  id          String          @id @default(uuid()) @db.Uuid
  ownerUserId String          @map("owner_user_id") @db.Uuid
  name        String          @db.VarChar(80)
  status      HouseholdStatus @default(active)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  accesses    HouseholdAccess[]
  members     HouseholdMember[]
  relationships HouseholdRelationship[]
  invitations HouseholdInvitation[]

  @@index([ownerUserId, status, createdAt], map: "customer_household_owner_status_idx")
  @@map("households")
  @@schema("customer_household")
}

model HouseholdAccess {
  id          String               @id @default(uuid()) @db.Uuid
  householdId String               @map("household_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  role        HouseholdAccessRole  @default(owner)
  status      HouseholdAccessStatus @default(active)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  household   Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@unique([householdId, userId], map: "customer_household_access_household_user_key")
  @@index([userId, status, householdId], map: "customer_household_access_user_status_idx")
  @@map("household_accesses")
  @@schema("customer_household")
}

model HouseholdMember {
  id           String               @id @default(uuid()) @db.Uuid
  householdId  String               @map("household_id") @db.Uuid
  displayName  String               @map("display_name") @db.VarChar(80)
  relationship String               @db.VarChar(40)
  familyPersonId String?             @map("family_person_id") @db.Uuid
  displayGender HouseholdMemberGender? @map("display_gender")
  isSelf       Boolean              @default(false) @map("is_self")
  birthDate    DateTime?            @map("birth_date") @db.Date
  isDependent  Boolean              @default(true) @map("is_dependent")
  status       HouseholdMemberStatus @default(active)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  household    Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)
  familyPerson FamilyPerson?        @relation(fields: [familyPersonId], references: [id], onDelete: Restrict)
  outgoingRelationships HouseholdRelationship[] @relation("HouseholdRelationshipFrom")
  incomingRelationships HouseholdRelationship[] @relation("HouseholdRelationshipTo")
  invitations HouseholdInvitation[]
  relatedInvitations HouseholdInvitation[] @relation("HouseholdInvitationRelative")

  @@index([householdId, status, createdAt], map: "customer_household_member_household_status_idx")
  @@unique([householdId, id], map: "customer_household_member_household_id_id_key")
  @@unique([householdId, familyPersonId], map: "customer_household_member_household_person_key")
  @@index([familyPersonId], map: "customer_household_member_person_idx")
  @@index([householdId, isSelf, status], map: "customer_household_member_self_idx")
  @@map("household_members")
  @@schema("customer_household")
}

model FamilyPerson {
  id            String           @id @default(uuid()) @db.Uuid
  accountUserId String?          @unique(map: "customer_household_family_person_account_user_key") @map("account_user_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  members       HouseholdMember[]

  @@map("family_people")
  @@schema("customer_household")
}

model HouseholdRelationship {
  id          String                      @id @db.Uuid
  householdId String                      @map("household_id") @db.Uuid
  fromMemberId String                     @map("from_member_id") @db.Uuid
  toMemberId  String                      @map("to_member_id") @db.Uuid
  kind        HouseholdRelationshipKind
  basis       HouseholdRelationshipBasis  @default(unspecified)
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  household   Household                  @relation(fields: [householdId], references: [id], onDelete: Restrict)
  fromMember  HouseholdMember            @relation("HouseholdRelationshipFrom", fields: [householdId, fromMemberId], references: [householdId, id], onDelete: Restrict)
  toMember    HouseholdMember            @relation("HouseholdRelationshipTo", fields: [householdId, toMemberId], references: [householdId, id], onDelete: Restrict)

  @@unique([householdId, fromMemberId, toMemberId, kind], map: "customer_household_relationship_edge_key")
  @@index([householdId, kind, fromMemberId], map: "customer_household_relationship_from_idx")
  @@index([householdId, kind, toMemberId], map: "customer_household_relationship_to_idx")
  @@map("household_relationships")
  @@schema("customer_household")
}

model HouseholdInvitation {
  id              String                    @id @db.Uuid
  householdId     String                    @map("household_id") @db.Uuid
  memberId        String                    @map("member_id") @db.Uuid
  relativeMemberId String?                  @map("relative_member_id") @db.Uuid
  kind            HouseholdInvitationKind
  status          HouseholdInvitationStatus @default(pending)
  relationshipKind HouseholdRelationshipKind? @map("relationship_kind")
  relationshipBasis HouseholdRelationshipBasis? @map("relationship_basis")
  newMemberIsFrom Boolean?                  @map("new_member_is_from")
  targetUserId    String?                   @map("target_user_id") @db.Uuid
  targetPhoneHash String?                   @map("target_phone_hash") @db.Char(64)
  tokenHash       String                    @unique(map: "customer_household_invitation_token_hash_key") @map("token_hash") @db.Char(64)
  tokenKeyVersion String                    @default("v1") @map("token_key_version") @db.VarChar(16)
  createdByUserId String                    @map("created_by_user_id") @db.Uuid
  acceptedByUserId String?                  @map("accepted_by_user_id") @db.Uuid
  claimUserId     String?                   @map("claim_user_id") @db.Uuid
  expiresAt       DateTime?                 @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?                 @map("accepted_at") @db.Timestamptz(6)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  household       Household                 @relation(fields: [householdId], references: [id], onDelete: Restrict)
  member          HouseholdMember           @relation(fields: [householdId, memberId], references: [householdId, id], onDelete: Restrict)
  relativeMember  HouseholdMember?          @relation("HouseholdInvitationRelative", fields: [householdId, relativeMemberId], references: [householdId, id], onDelete: Restrict)

  @@index([targetUserId, status, createdAt], map: "customer_household_invitation_target_user_idx")
  @@index([householdId, status, createdAt], map: "customer_household_invitation_household_status_idx")
  @@index([expiresAt, status], map: "customer_household_invitation_expiry_idx")
  @@map("household_invitations")
  @@schema("customer_household")
}

model AuditLog {
  id             String   @id @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  callerService  String   @map("caller_service") @db.VarChar(80)
  action         String   @db.VarChar(120)
  resourceType   String   @map("resource_type") @db.VarChar(40)
  resourceId     String   @map("resource_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.Uuid
  reason         String?  @db.VarChar(500)
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId, createdAt, id], map: "customer_household_audit_actor_created_idx")
  @@index([resourceType, resourceId, createdAt], map: "customer_household_audit_resource_created_idx")
  @@index([correlationId], map: "customer_household_audit_correlation_idx")
  @@map("audit_logs")
  @@schema("customer_household")
}

model IdempotencyCommand {
  callerService String   @map("caller_service") @db.VarChar(80)
  key           String   @db.Uuid
  requestHash   String   @map("request_hash") @db.Char(64)
  response      Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([callerService, key])
  @@index([createdAt], map: "customer_household_idempotency_created_idx")
  @@map("idempotency_commands")
  @@schema("customer_household")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(160)
  aggregateId    String    @map("aggregate_id") @db.VarChar(80)
  envelope       Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  leaseToken     String?   @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(80)

  @@index([publishedAt, deadLetteredAt, availableAt, createdAt], map: "customer_household_outbox_delivery_idx")
  @@map("outbox_events")
  @@schema("customer_household")
}
