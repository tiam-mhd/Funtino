NODE_ENV=development
CUSTOMER_HOUSEHOLD_PORT=4080
CUSTOMER_HOUSEHOLD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=customer_household
CUSTOMER_HOUSEHOLD_MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB?schema=customer_household
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/%2f

# Metrics token is required in production (unique per service/environment, at least 32 random characters).
# Keep each caller token separate and configure the matching pair only in private runtime secrets.
CUSTOMER_HOUSEHOLD_METRICS_TOKEN=
CUSTOMER_HOUSEHOLD_GATEWAY_TOKEN=
CUSTOMER_HOUSEHOLD_WALLET_TOKEN=
# Tokens use the OS CSPRNG and only SHA-256 hashes are stored.
CUSTOMER_FAMILY_UNREGISTERED_INVITATION_TTL_DAYS=7

# Docker startup requires both database URLs, prepares this schema, and applies pending migrations before this Worker starts.
# In deployment keep both URLs in private secrets for the same database/schema; grant DDL only to the migration URL.
