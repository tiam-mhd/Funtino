# Runtime API boundary. Demo mode is explicit until the first API contract is connected.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DATA_MODE=api

# Backend local runtime. Never put real secrets in this file.
NODE_ENV=development
API_PORT=4000
API_METRICS_TOKEN=
# Private Prometheus query API. Production requires private HTTPS; never expose this URL to the browser.
PROMETHEUS_INTERNAL_URL=http://localhost:9090
REALTIME_PORT=4010
REALTIME_METRICS_TOKEN=
DEVICE_PORT=4020
DEVICE_INTEGRATION_METRICS_TOKEN=
DEVICE_INTEGRATION_URL=http://localhost:4020
DEVICE_INTEGRATION_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=device_integration
# Local-only example reuses the compose credential; production migration credentials must be separate.
DEVICE_INTEGRATION_MIGRATION_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=device_integration
# Use the same unique >=32-character runtime secret in Gateway and Device Integration.
DEVICE_INTEGRATION_GATEWAY_TOKEN=
NOTIFICATIONS_PORT=4030
NOTIFICATIONS_METRICS_TOKEN=
IDENTITY_ACCESS_PORT=4040
IDENTITY_ACCESS_METRICS_TOKEN=
ORGANIZATION_BRANCH_PORT=4050
ORGANIZATION_BRANCH_METRICS_TOKEN=
ANALYTICS_PORT=4060
ANALYTICS_METRICS_TOKEN=
APP_VERSION=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
API_BASE_URL=http://localhost:4000
STORAGE_MODE=memory
DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=public
# Local-only example reuses the compose credential; production uses a distinct migration-only role.
DATABASE_MIGRATION_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=public
IDENTITY_ACCESS_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=identity_access
# Local-only example uses the same compose credential; production migration credentials must be separate and privileged only for migrations.
IDENTITY_ACCESS_MIGRATION_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=identity_access
ORGANIZATION_BRANCH_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=organization_branch
# Keep the runtime and migration credentials separate in deployed environments.
ORGANIZATION_BRANCH_MIGRATION_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=organization_branch
# Local development only; production requires HTTPS and redirects are never followed.
ORGANIZATION_BRANCH_URL=http://localhost:4050
# Internal owner URL is used only service-to-service. Use unique random >=32-character secrets per caller;
# Identity Access and Wallet credentials are restricted to POST /internal/v1/scopes/validate.
ORGANIZATION_BRANCH_GATEWAY_TOKEN=
ORGANIZATION_BRANCH_IDENTITY_ACCESS_TOKEN=
ORGANIZATION_BRANCH_DEVICE_INTEGRATION_TOKEN=
ORGANIZATION_BRANCH_WALLET_TOKEN=
# Wallet owner uses a separate schema and separate runtime/migration credentials.
WALLET_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=wallet
WALLET_MIGRATION_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=wallet
WALLET_PORT=4070
# Same per-environment secret in Gateway and Wallet; never use a public service URL in production.
WALLET_GATEWAY_TOKEN=
WALLET_URL=http://localhost:4070
WALLET_ORGANIZATION_BRANCH_INTERNAL_URL=http://localhost:4050
WALLET_ORGANIZATION_BRANCH_TOKEN=
WALLET_METRICS_TOKEN=
# Customer & Household owns household/member data. Gateway and Wallet use different credentials.
CUSTOMER_HOUSEHOLD_PORT=4080
CUSTOMER_HOUSEHOLD_METRICS_TOKEN=
CUSTOMER_HOUSEHOLD_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=customer_household
CUSTOMER_HOUSEHOLD_MIGRATION_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=customer_household
CUSTOMER_HOUSEHOLD_URL=http://localhost:4080
CUSTOMER_HOUSEHOLD_GATEWAY_TOKEN=
CUSTOMER_HOUSEHOLD_WALLET_TOKEN=
CUSTOMER_FAMILY_PHONE_HASH_SECRET=
# Expiry for links sent to phone numbers without an account. Registered account invitations do not expire.
CUSTOMER_FAMILY_UNREGISTERED_INVITATION_TTL_DAYS=7
WALLET_CUSTOMER_HOUSEHOLD_INTERNAL_URL=http://localhost:4080
WALLET_CUSTOMER_HOUSEHOLD_TOKEN=
# Use a separate >=32-character runtime secret for Gateway -> Analytics; never reuse owner credentials.
ANALYTICS_API_GATEWAY_TOKEN=
ANALYTICS_READ_MODEL_URL=http://localhost:4060
# Backfill reads this source with a dedicated PostgreSQL read-only account.
LEGACY_GATEWAY_READONLY_DATABASE_URL=
# Local example reuses the compose user; production must use a dedicated target account with SELECT/INSERT only.
ORGANIZATION_BRANCH_BACKFILL_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=organization_branch
ORGANIZATION_BRANCH_BACKFILL_APPLY_ENABLED=false
ALLOW_PRODUCTION_ORGANIZATION_BRANCH_BACKFILL=false
ANALYTICS_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=analytics_read_model
# Local example reuses the compose user; production runtime and migration credentials must be separate.
ANALYTICS_MIGRATION_DATABASE_URL=postgresql://funtino:funtino@localhost:5432/funtino?schema=analytics_read_model
DEVICE_HEALTH_STALE_AFTER_SECONDS=300
DEVICE_HEALTH_OFFLINE_AFTER_SECONDS=900
IDENTITY_ACCESS_URL=http://localhost:4040
# Generate a unique >=32-character development-only value; set runtime secret separately in production.
IDENTITY_ACCESS_SERVICE_TOKEN=
# Production manager commands stay closed unless explicitly opened during an approved rollout.
IDENTITY_ACCESS_MANAGEMENT_WRITES_ENABLED=false
# Set true only in the environment of an interactive, one-off bootstrap CLI invocation.
IDENTITY_ACCESS_BOOTSTRAP_ENABLED=false
# Generate a unique 32-byte base64 AES key per environment; keep the runtime keyring outside source control.
IDENTITY_ACCESS_MFA_ENCRYPTION_KEYS=
IDENTITY_ACCESS_MFA_ACTIVE_KEY_VERSION=v1
# JSON keyring of base64-encoded 32-byte HMAC keys; retain old versions during rotation.
IDENTITY_ACCESS_LOOKUP_HMAC_KEYS=
IDENTITY_ACCESS_LOOKUP_ACTIVE_KEY_VERSION=v1
RABBITMQ_URL=amqp://funtino:funtino@localhost:5672/%2f
REDIS_URL=redis://localhost:6379
DEVICE_WEBHOOK_SECRET=replace-in-local-secret
EXPOSE_DEV_OTP=true
SESSION_COOKIE_DOMAIN=

# Parsgreen OTP adapter. Keep the token empty in source control and set it only in Runflare secrets.
PARSGREEN_API_TOKEN=
PARSGREEN_AUTH_HEADER=Authorization
PARSGREEN_OTP_URL=https://sms.parsgreen.ir/Apiv2/Message/SendOtp
# Use the template/pattern ID approved for the Parsgreen account; 0 follows the SDK default.
PARSGREEN_OTP_TEMPLATE_ID=0
PARSGREEN_ADD_NAME=false
PARSGREEN_REQUEST_TIMEOUT_MS=8000
