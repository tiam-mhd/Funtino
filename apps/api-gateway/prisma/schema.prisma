generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum MembershipRole {
  customer
  cashier
  operator
  branch_manager
  organization_manager
  crm_manager
  system_admin
  support
}

enum AssetType {
  purchased_credit
  gift_credit
  loyalty_points
}

enum LedgerKind {
  top_up
  spend
  refund
  adjustment
  reward
  expiry
}

enum CardStatus {
  pending_sync
  active
  blocked
  unlinked
}

enum MissionStatus {
  draft
  published
  active
  expired
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  phoneE164          String            @unique @map("phone_e164")
  displayName        String?           @map("display_name")
  firstName          String?           @map("first_name")
  lastName           String?           @map("last_name")
  email              String?           @unique
  birthDate          DateTime?         @map("birth_date")
  gender             String?
  city               String?
  avatarPreset       String?           @map("avatar_preset")
  profileCompletedAt DateTime?         @map("profile_completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  sessions           Session[]
  memberships        Membership[]
  householdsOwned    Household[]       @relation("household_owner")
  householdMembers   HouseholdMember[]
  auditLogs          AuditLog[]
  avatar             UserAvatar?

  @@map("users")
}

model UserAvatar {
  userId    String   @id @map("user_id") @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phoneE164  String    @map("phone_e164")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phoneE164, createdAt])
  @@map("otp_challenges")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  mfaVerifiedAt    DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  mfaFactorVersion Int?      @map("mfa_factor_version")
  mfaMethod        String?   @map("mfa_method") @db.VarChar(16)
  isSystemAdmin    Boolean   @default(false) @map("is_system_admin")
  mfaLoginDeadlineAt DateTime? @map("mfa_login_deadline_at") @db.Timestamptz(6)
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  timezone    String       @default("Asia/Tehran")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  branches    Branch[]
  memberships Membership[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  slug           String
  address        String
  city           String
  timezone       String       @default("Asia/Tehran")
  isActive       Boolean      @default(true) @map("is_active")
  openingHours   Json         @map("opening_hours")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("branches")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, branchId, role])
  @@index([organizationId, branchId, role])
  @@map("memberships")
}

model Household {
  id          String            @id @default(uuid()) @db.Uuid
  ownerUserId String            @map("owner_user_id") @db.Uuid
  name        String
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  owner       User              @relation("household_owner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members     HouseholdMember[]
  cards       Card[]
  wallets     WalletAccount[]

  @@index([ownerUserId])
  @@map("households")
}

model HouseholdMember {
  id           String    @id @default(uuid()) @db.Uuid
  householdId  String    @map("household_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  displayName  String    @map("display_name")
  relationship String
  birthDate    DateTime? @map("birth_date")
  isDependent  Boolean   @default(true) @map("is_dependent")
  createdAt    DateTime  @default(now()) @map("created_at")
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  cards        Card[]

  @@index([householdId])
  @@map("household_members")
}

model Card {
  id             String           @id @default(uuid()) @db.Uuid
  householdId    String           @map("household_id") @db.Uuid
  memberId       String?          @map("member_id") @db.Uuid
  branchId       String?          @map("branch_id") @db.Uuid
  externalCardId String           @unique @map("external_card_id")
  status         CardStatus       @default(pending_sync)
  lastSyncedAt   DateTime?        @map("last_synced_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  household      Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member         HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  wallets        WalletAccount[]

  @@index([householdId, status])
  @@index([branchId, status])
  @@map("cards")
}

model WalletAccount {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  cardId      String?       @map("card_id") @db.Uuid
  currency    String        @default("IRR")
  createdAt   DateTime      @default(now()) @map("created_at")
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  card        Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  entries     LedgerEntry[]

  @@index([householdId])
  @@map("wallet_accounts")
}

model LedgerEntry {
  id             String        @id @default(uuid()) @db.Uuid
  walletId       String        @map("wallet_id") @db.Uuid
  assetType      AssetType     @map("asset_type")
  kind           LedgerKind
  amountMinor    BigInt        @map("amount_minor")
  currency       String
  idempotencyKey String        @unique @map("idempotency_key")
  source         String
  occurredAt     DateTime      @map("occurred_at")
  metadata       Json?
  wallet         WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, occurredAt])
  @@map("ledger_entries")
}

model Mission {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  title          String
  description    String
  status         MissionStatus     @default(draft)
  rewardType     String            @map("reward_type")
  rewardValue    Int               @map("reward_value")
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime?         @map("ends_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  progress       MissionProgress[]

  @@index([organizationId, branchId, status])
  @@map("missions")
}

model MissionProgress {
  id          String    @id @default(uuid()) @db.Uuid
  missionId   String    @map("mission_id") @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  progress    Int       @default(0)
  completedAt DateTime? @map("completed_at")
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, householdId])
  @@map("mission_progress")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  eventType   String    @map("event_type")
  aggregateId String    @map("aggregate_id")
  payload     Json
  occurredAt  DateTime  @map("occurred_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

model InboxEvent {
  eventId    String   @map("event_id") @db.Uuid
  consumer   String
  receivedAt DateTime @default(now()) @map("received_at")

  @@id([eventId, consumer])
  @@map("inbox_events")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  organizationId String?  @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  correlationId  String   @map("correlation_id")
  reason         String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at")
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model CustomerLookupRateLimit {
  actorUserId     String   @map("actor_user_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([actorUserId, branchId], map: "customer_lookup_rate_limits_pkey")
  @@index([windowStartedAt], map: "customer_lookup_rate_limits_window_idx")
  @@map("customer_lookup_rate_limits")
}
