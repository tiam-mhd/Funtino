NODE_ENV=production
APP_VERSION=replace-with-deployment-commit
API_PORT=4000
API_METRICS_TOKEN=
CORS_ORIGINS=https://app.funtino.ir,https://web.funtino.ir,https://admin.funtino.ir
API_BASE_URL=https://api.funtino.ir
STORAGE_MODE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB?schema=public
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/%2f
REDIS_URL=redis://HOST:6379
PROMETHEUS_INTERNAL_URL=https://<private-prometheus-host>
SESSION_COOKIE_DOMAIN=.funtino.ir
EXPOSE_DEV_OTP=false
SYSTEM_ADMIN_OWNER_PHONE_E164=
# Same private runtime secret is passed only to API Gateway and Identity & Access.
SYSTEM_ADMIN_BOOTSTRAP_LOOKUP_TOKEN=

# Provider credentials are runtime-only secrets. Keep values empty in source control.
PARSGREEN_API_TOKEN=
PARSGREEN_AUTH_HEADER=Authorization
PARSGREEN_OTP_URL=https://sms.parsgreen.ir/Apiv2/Message/SendOtp
PARSGREEN_OTP_TEMPLATE_ID=0
PARSGREEN_ADD_NAME=false
PARSGREEN_REQUEST_TIMEOUT_MS=8000

# In production, all private backend URLs use their exact Runflare ClusterIP network alias and Port 80.
# The alias must be a single hostname ending in -service; public HTTP URLs and NodePorts are rejected.
IDENTITY_ACCESS_URL=http://<identity-access-clusterip-network-name>:80
IDENTITY_ACCESS_SERVICE_TOKEN=
ORGANIZATION_BRANCH_URL=http://<organization-branch-clusterip-network-name>:80
ORGANIZATION_BRANCH_INTERNAL_URL=http://<organization-branch-clusterip-network-name>:80
ORGANIZATION_BRANCH_GATEWAY_TOKEN=
DEVICE_INTEGRATION_URL=http://<device-integration-clusterip-network-name>:80
DEVICE_INTEGRATION_GATEWAY_TOKEN=
DEVICE_INTEGRATION_ORGANIZATION_BRANCH_TOKEN=
WALLET_URL=http://<wallet-clusterip-network-name>:80
WALLET_GATEWAY_TOKEN=
CUSTOMER_HOUSEHOLD_URL=http://<customer-household-clusterip-network-name>:80
CUSTOMER_HOUSEHOLD_GATEWAY_TOKEN=
# HMAC key for exact-phone family invitations and inbox matching; use one stable unique 32-512 character secret across API Gateway replicas.
CUSTOMER_FAMILY_PHONE_HASH_SECRET=
ANALYTICS_READ_MODEL_URL=http://<analytics-clusterip-network-name>:80
ANALYTICS_API_GATEWAY_TOKEN=

# Database migration URL is for a one-shot migration job only, not application runtime.
