NODE_ENV=production
APP_VERSION=replace-with-deployment-commit
API_PORT=4000
API_METRICS_TOKEN=
CORS_ORIGINS=https://app.funtino.ir,https://web.funtino.ir,https://admin.funtino.ir
API_BASE_URL=https://api.funtino.ir
STORAGE_MODE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB?schema=public
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/%2f
REDIS_URL=redis://HOST:6379
PROMETHEUS_INTERNAL_URL=https://<private-prometheus-host>
SESSION_COOKIE_DOMAIN=.funtino.ir
EXPOSE_DEV_OTP=false

# Provider credentials are runtime-only secrets. Keep values empty in source control.
PARSGREEN_API_TOKEN=
PARSGREEN_AUTH_HEADER=Authorization
PARSGREEN_OTP_URL=https://sms.parsgreen.ir/Apiv2/Message/SendOtp
PARSGREEN_OTP_TEMPLATE_ID=0
PARSGREEN_ADD_NAME=false
PARSGREEN_REQUEST_TIMEOUT_MS=8000

# Private service endpoints must use HTTPS in production; each caller token is unique per pair/environment.
IDENTITY_ACCESS_URL=https://<private-identity-access-host>
IDENTITY_ACCESS_SERVICE_TOKEN=
ORGANIZATION_BRANCH_URL=https://<private-organization-branch-host>
ORGANIZATION_BRANCH_INTERNAL_URL=https://<private-organization-branch-host>
ORGANIZATION_BRANCH_GATEWAY_TOKEN=
DEVICE_INTEGRATION_URL=https://<private-device-worker-host>
DEVICE_INTEGRATION_GATEWAY_TOKEN=
DEVICE_INTEGRATION_ORGANIZATION_BRANCH_TOKEN=
WALLET_URL=https://<private-wallet-host>
WALLET_GATEWAY_TOKEN=
CUSTOMER_HOUSEHOLD_URL=https://<private-customer-household-host>
CUSTOMER_HOUSEHOLD_GATEWAY_TOKEN=
ANALYTICS_READ_MODEL_URL=https://<private-analytics-host>
ANALYTICS_API_GATEWAY_TOKEN=

# Database migration URL is for a one-shot migration job only, not application runtime.
